# Free collection does not require an OpenAI API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Requires explicit --sources openai as well. Never auto-fallback.
PAID_SEARCH_ENABLED=false
SEARCH_MAX_TOOL_CALLS=1
NEWS_SOURCES=["rss","hatena","zenn","qiita","nvd"]
RSS_FEEDS=["https://huggingface.co/blog/feed.xml","https://www.jpcert.or.jp/rss/jpcert.rdf"]
ZENN_TOPICS=["ai","security"]
# Optional free API credentials; keep values out of Git.
NVD_API_KEY=
QIITA_ACCESS_TOKEN=
API_TIMEOUT_SECONDS=60
SOURCE_DEADLINE_SECONDS=90
SEARCH_CONCURRENCY=3
SOURCE_MAX_PAGES=2
SOURCE_MAX_CANDIDATES=100
MAX_RESPONSE_BYTES=2000000
SEARCH_TIMEZONE=UTC
INCLUDE_UNKNOWN_DATES=true
CVE_LIMIT=5

# Research LLM is separate from paid Web Search permission.
RESEARCH_MODEL=gpt-6-luna
RESEARCH_MAX_TOOL_CALLS=3
RESEARCH_MAX_TURNS=4
RESEARCH_MAX_OUTPUT_TOKENS=2000
RESEARCH_TOOL_TIMEOUT=90
RESEARCH_TIMEOUT=180
